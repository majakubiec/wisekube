---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="About">
  <PageHero title="About" subtitle="Why a kube?" />
  <section class="container-prose py-16">
    <div class="prose prose-neutral dark:prose-invert max-w-none">
      <p>A kube is a cube with a k. Its walls stand for containment: not to keep the world out, but to keep what matters in. This is my safe place.</p>
      <p>Replace this with your own story.</p>
    </div>
  </section>
</Layout>
