---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import FeaturedPost from '../../components/FeaturedPost.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
---

<Layout title="Blog" description="Tech, code and other thoughts, kept safe inside the kube.">
  <PageHero title="Blog" subtitle="Tech, code and other thoughts, kept safe inside the kube." />

  {
    featured && (
      <section class="py-12 md:py-16">
        <div class="container-content">
          <FeaturedPost post={featured} />
        </div>
      </section>
    )
  }

  <section class="pb-16 md:pb-24">
    <div class="container-content">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => <PostCard post={post} delay={(i % 6) + 1} />)}
      </div>
    </div>
  </section>
</Layout>
