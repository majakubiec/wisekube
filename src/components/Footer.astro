---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
const socials = [
  // Disabled for now:
  // { label: 'GitHub', href: 'https://github.com/', path: 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z' },
  { label: 'X', href: 'https://x.com/_eemat_', path: 'M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77L17.75 3Zm-1.08 16.2h1.7L7.4 4.73H5.58l11.09 14.47Z' },
];
---

<footer class="mt-24 border-t border-line-soft bg-surface">
  <div class="container-content grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-4 max-w-[36ch] text-[14px] leading-relaxed text-soft">{SITE.tagline}</p>
      <div class="mt-5 flex gap-2">
        {
          socials.map((s) => (
            <a href={s.href} aria-label={s.label} class="inline-flex size-9 items-center justify-center rounded-lg border border-line-soft text-soft transition-colors hover:text-strong">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-muted">Navigation</h2>
      <ul class="mt-4 space-y-2.5 text-[14px]">
        {SITE.nav.map((item) => <li><a href={item.href} class="text-soft hover:text-strong">{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-mono text-[11px] uppercase tracking-wider text-muted">Elsewhere</h2>
      <ul class="mt-4 space-y-2.5 text-[14px]">
        <li><a href="/rss.xml" class="text-soft hover:text-strong">RSS feed</a></li>
        <li><a href="/sitemap-index.xml" class="text-soft hover:text-strong">Sitemap</a></li>
      </ul>
    </div>
  </div>
  <div class="container-content flex flex-col gap-2 border-t border-line-soft py-6 text-[13px] text-muted sm:flex-row sm:justify-between">
    <span>© {year} {SITE.name}. All rights reserved.</span>
    <span>Built with Astro.</span>
  </div>
</footer>
