---
import { SITE } from '../lib/site';
---

<a href="/" class="inline-flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
  <svg class="size-7" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="kube-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--color-accent-1)" />
        <stop offset=".5" stop-color="var(--color-accent-2)" />
        <stop offset="1" stop-color="var(--color-accent-3)" />
      </linearGradient>
    </defs>
    <path d="M16 3 28 9.5v13L16 29 4 22.5v-13Z" fill="url(#kube-g)" />
    <path d="M4 9.5 16 16l12-6.5M16 16v13" fill="none" stroke="#111" stroke-opacity=".85" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
  <span class="text-[15px] font-bold tracking-[-0.03em] text-strong">{SITE.name}</span>
</a>
