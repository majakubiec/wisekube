---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  delay?: number;
}

const { post, delay } = Astro.props;
const { title, description, category, author, pubDate, image } = post.data;
---

<a
  href={`/blog/${post.id}/`}
  class="reveal group overflow-hidden rounded-xl border border-line-soft bg-bg transition-all duration-300 hover:shadow-soft"
  data-delay={delay}
>
  <div class="aspect-[16/10] overflow-hidden bg-elevated">
    {
      image ? (
        <img src={image} alt="" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
      ) : (
        <div class="hero-gradient size-full" />
      )
    }
  </div>
  <div class="p-6">
    <span class="inline-block rounded bg-elevated px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-muted">{category}</span>
    <h3 class="mt-3 text-[1.05rem] font-semibold tracking-[-0.02em] text-strong transition-opacity duration-200 group-hover:opacity-70">{title}</h3>
    <p class="mt-2 line-clamp-2 text-[0.875rem] leading-relaxed text-soft">{description}</p>
    <div class="mt-4 flex items-center gap-2 text-[0.8rem] text-muted">
      <span>{author}</span>
      <span aria-hidden="true">&middot;</span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </div>
  </div>
</a>
