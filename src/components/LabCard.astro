---
import type { LabItem } from '../lib/lab';
import { formatDate } from '../lib/site';

interface Props {
  item: LabItem;
  delay?: number;
}

const { item, delay } = Astro.props;
---

<a
  href={item.href}
  class="reveal group overflow-hidden rounded-xl border border-line-soft bg-bg transition-all duration-300 hover:shadow-soft"
  data-delay={delay}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-elevated">
    {
      item.cover ? (
        <img src={item.cover} alt="" loading="lazy" decoding="async" class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
      ) : (
        // Live preview: render the page at desktop size and scale it down to fit the card
        <iframe
          src={item.href}
          title={`Preview of ${item.title}`}
          loading="lazy"
          tabindex="-1"
          aria-hidden="true"
          sandbox="allow-scripts allow-same-origin"
          class="pointer-events-none absolute left-0 top-0 h-[400%] w-[400%] origin-top-left scale-25 border-0 bg-white"
        />
      )
    }
  </div>
  <div class="p-6">
    <span class="inline-block rounded bg-elevated px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-muted">/lab/{item.slug}</span>
    <h3 class="mt-3 text-[1.05rem] font-semibold tracking-[-0.02em] text-strong transition-opacity duration-200 group-hover:opacity-70">{item.title}</h3>
    {item.description && <p class="mt-2 line-clamp-2 text-[0.875rem] leading-relaxed text-soft">{item.description}</p>}
    <div class="mt-4 text-[0.8rem] text-muted">
      <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
    </div>
  </div>
</a>
